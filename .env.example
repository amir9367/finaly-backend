# Copy this file to `.env` (same folder as docker-compose.yml) and fill in
# real values. docker compose reads .env automatically; every variable below
# marked required will fail startup if missing.

# --- Required ---
POSTGRES_PASSWORD=change-me-strong-db-password
JWT_SECRET=change-me-use-32-plus-random-characters
ADMIN_PASSWORD=change-me-strong-admin-password

# --- Optional ---
ADMIN_USERNAME=admin
SMS_PROVIDER=Melipayamak
MELI_USERNAME=
MELI_PASSWORD=
MELI_ORIGIN=
